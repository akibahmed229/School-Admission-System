# Optional. Every value below already has this default inside docker-compose.yml,
# so `docker compose up` works without creating a .env file.
POSTGRES_DB=school_admission
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Seconds a seat stays on hold before it is released automatically.
HOLD_DURATION_SECONDS=600

# URL the browser uses to reach the backend API.
API_BASE_URL=http://localhost:8080
